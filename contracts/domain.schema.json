{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "文化政策依赖协调领域事件",
  "description": "用于跨模块交换事实记录的公共信封。payload 承载各事件类型的业务字段，见 docs/event-catalog.md。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识；来源系统重试必须沿用原标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "POLICY_PUBLISHED",
        "POLICY_EXTENDED",
        "POLICY_REPEALED",
        "POLICY_TRANSITION_DECLARED",
        "DEPENDENCY_DECLARED",
        "DEPENDENCY_REBASED",
        "CONFLICT_RAISED",
        "CONFLICT_CLEARED",
        "OPINION_ISSUED",
        "CASE_ACCEPTED",
        "CASE_SUPPLEMENT_REQUESTED",
        "CASE_MATERIAL_RESUBMITTED",
        "CASE_DECIDED",
        "CASE_REVIEWED",
        "CASE_REVIEW_RESOLVED",
        "CASE_TRANSITION_APPLIED"
      ],
      "description": "本领域事件类型"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "policy_clause",
        "dependency_edge",
        "application_case",
        "agency_opinion"
      ],
      "description": "业务对象类型"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间（迟到补录也填真实发生时间，不是入库时间）"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "聚合内版本号，从 1 开始递增"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    },
    "payload": {
      "type": "object",
      "description": "事件业务字段，结构见 docs/event-catalog.md"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "服务入库时间，由接收方填写"
    }
  },
  "additionalProperties": true
}
